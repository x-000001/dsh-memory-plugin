{
  "name": "dsh-plugin-memory",
  "version": "0.1.0",
  "description": "Cross-project long-term memory for DeepSeek Harness: four isolated stores, progressive disclosure, audited habit learning, zero-LLM core.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.6",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "long-term-memory",
    "cordis-plugin",
    "agent-memory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "meta": {
    "title": "Memory",
    "description": "Layered long-term memory with progressive disclosure and a human-gated habit pipeline."
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/build.mjs --check && node scripts/verify-package.mjs && node scripts/test.mjs",
    "pack:dry": "pnpm pack --dry-run",
    "prepack": "node scripts/build.mjs --check && node scripts/verify-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-memory-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-memory-plugin/issues"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-memory-plugin#readme",
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public"
  }
}
